
AddDefaultCharset UTF-8
<IfModule mod_rewrite.c>
RewriteEngine On

# Redirect jika user membuka .html langsung (external redirect)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

# Shortlinks - rewrite to static handler
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^s/([a-z0-9-]+)/?$ index.html [L,QSA]

# CMS React SPA Admin rewrite
RewriteCond %{REQUEST_URI} ^/admin
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^admin/.* /admin/index.html [L]

# Secara internal cari file .html (jika file .html tidak langsung request)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
