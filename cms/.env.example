# =============================================================
# Ramahfakhirin CMS - environment
# Copy file ini jadi `.env` lalu isi dengan credential Supabase kamu.
# Ambil di: Supabase Dashboard > Project Settings > API
# =============================================================

# Project URL, contoh: https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# anon / public key (AMAN dipakai di browser, dilindungi RLS)
VITE_SUPABASE_ANON_KEY=

# Nama bucket storage untuk upload gambar
VITE_SUPABASE_BUCKET=cms-media

# URL website utama, dipakai untuk tombol "Lihat Halaman"
VITE_SITE_URL=https://ramahfakhirin.com

# CATATAN KEAMANAN:
# JANGAN pernah menaruh service_role key di file ini.
# Semua variabel VITE_* ikut ter-bundle ke JavaScript dan terlihat publik.
