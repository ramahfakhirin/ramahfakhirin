# ── Server ──────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=ganti_dengan_string_random_panjang_minimal_64_karakter
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=rama
ADMIN_PASSWORD=ganti_password_aman_kamu

# ── Email (SMTP) ─────────────────────────────────────
# Gunakan Gmail App Password atau SMTP provider lain
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ramafakhirin@gmail.com
SMTP_PASS=gmail_app_password_kamu

# Email yang menerima notif contact form
NOTIFY_EMAIL=ramafakhirin@gmail.com
SITE_URL=https://ramahfakhirin.com

# ── Upload ───────────────────────────────────────────
UPLOAD_DIR=public/uploads
MAX_FILE_SIZE_MB=5

# ── Database ─────────────────────────────────────────
DB_PATH=database/app.db
